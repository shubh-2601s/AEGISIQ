# ==============================================================================
# AegisIQ Frontend Multi-Stage Dockerfile
# Base: Node 22 Alpine -> Nginx Alpine
# ==============================================================================

# Stage 1: Build Frontend Assets
FROM node:22-alpine AS builder
WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci || npm install

COPY frontend/ .
RUN npm run build || mkdir -p dist && echo "<!DOCTYPE html><html><body><h1>AegisIQ Frontend Shell</h1></body></html>" > dist/index.html

# Stage 2: Hardened Nginx Web Server
FROM nginx:1.27-alpine AS runtime

# Copy custom Nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built SPA assets
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 5173

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5173/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

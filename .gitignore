# ==========================================
# AegisIQ Git Ignore Rules
# ==========================================

# Environment & Secret Files (CRITICAL)
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.p12
*.jks
credentials.json
secrets/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Java / Maven (Backend)
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar

# Node.js / Frontend
frontend/node_modules/
**/node_modules/
frontend/dist/
frontend/build/
.npm
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Python (AI Service)
ai-service/venv/
**/venv/
**/env/
**/ENV/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Docker / Logs
*.log
logs/
docker-volumes/

# Test Artifacts & Temporary Files
tmp/
temp/
scratch/
security-test-lab/**/tmp/
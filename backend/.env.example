# AegisIQ Backend — Environment Variables
# !! NEVER COMMIT THIS FILE !!
# Copy this to .env and fill in your actual values.

# --- Supabase PostgreSQL ---
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
# Change postgresql:// to jdbc:postgresql://
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# --- JWT Secret (min 32 chars, random) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET_KEY_HERE

# --- AI Service (optional for now) ---
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_API_KEY=aegisiq-internal-service-secret-token

# --- CORS (your frontend URL) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==============================================================================
# AegisIQ Environment Variable Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the active .env file containing real secrets to version control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegisiq
POSTGRES_USER=aegisiq_user
POSTGRES_PASSWORD=change_this_postgres_password_in_production
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# --- Backend Service (Spring Boot) ---
BACKEND_PORT=8080
SERVER_PORT=${BACKEND_PORT}
JWT_SECRET=404e635266556a586e3272357538782f413f4428472b4b6250645367566b5970
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI Service (Python FastAPI) ---
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://${AI_SERVICE_HOST}:${AI_SERVICE_PORT}
INTERNAL_SERVICE_API_KEY=aegisiq-internal-service-secret-token

# --- LLM Provider Configuration (Configurable & Swappable) ---
# Options: mock, openai, anthropic, ollama
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0

# --- Frontend Service (React / Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=5173
